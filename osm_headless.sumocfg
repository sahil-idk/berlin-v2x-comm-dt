<?xml version="1.0" encoding="UTF-8"?>

<!-- Headless SUMO Configuration for V2V Distance Validation -->
<!-- Generated for headless operation without GUI -->

<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml.gz"/>
        <route-files value="osm_pt.rou.xml,osm.bicycle.trips.xml,osm.bus.trips.xml,osm.motorcycle.trips.xml,osm.passenger.trips.xml,osm.pedestrian.rou.xml,osm.truck.trips.xml"/>
        <additional-files value="osm.poly.xml.gz,osm_stops.add.xml,output.add.xml"/>
    </input>

    <output>
        <tripinfo-output value="headless_tripinfos.xml"/>
        <stop-output value="headless_stopinfos.xml"/>
        <statistic-output value="headless_stats.xml"/>
        <fcd-output value="headless_fcd.xml"/>
    </output>

    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="30"/>
    </processing>

    <routing>
        <device.rerouting.adaptation-steps value="18"/>
        <device.rerouting.adaptation-interval value="10"/>
    </routing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="true"/>
    </report>

    <!-- No GUI settings for headless mode -->

</sumoConfiguration>
